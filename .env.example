# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=

# Get your numeric Telegram user ID with /id, then restart the bot.
# Without this value, the owner panel and administrator features stay disabled.
OWNER_USER_ID=

# Optional but required for /tag to fetch every current group member through MTProto.
# Create an app at https://my.telegram.org and paste its api_id/api_hash here.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Keeps group switches, roles, bans, replies, and required membership after a restart.
STATE_DB_PATH=data/activation.sqlite3

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
